{
  "name": "ml-learning-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "new": "node scripts/new.mjs",
    "lint": "biome check . && stylelint \"{src,templates}/**/*.css\" && node --experimental-strip-types scripts/lint-lessons.mjs && node scripts/lint-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:isolation",
    "test:isolation": "node scripts/test-isolation.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "postcss": "^8.5.33",
    "remark-lint-heading-increment": "4.0.1",
    "remark-lint-no-duplicate-headings": "4.0.1",
    "remark-lint-no-undefined-references": "5.0.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
